{
  "name": "latch-engine",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "DNS automation: detect the provider from nameservers, plan the records a service needs, apply them through that provider's API, and verify they resolved. Portable across Cloudflare Workers and Node, zero runtime dependencies.",
  "keywords": [
    "dns",
    "dns-automation",
    "nameservers",
    "cloudflare",
    "route53",
    "namecheap",
    "domain-connect",
    "spf",
    "dkim",
    "dmarc",
    "dnssec",
    "cloudflare-workers"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mutation": "node scripts/mutation-runner.mjs . mutations.json",
    "test:mutation-runner": "node scripts/mutation-runner.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
